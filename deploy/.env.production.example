#--------------------------------------------------------------------
# PRODUCTION ENVIRONMENT - INLISLite 3.3 Kabupaten Solok
# Salin file ini menjadi .env di server, lalu sesuaikan nilainya.
# Jangan pernah mengunggah file .env ke folder public.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------
app.indexPage = ''
app.baseURL   = 'https://inlislite.solokkab.go.id/'
app.siteURL   = 'https://inlislite.solokkab.go.id'
app.uriProtocol = 'REQUEST_URI'
app.checkURL  = false

#--------------------------------------------------------------------
# DATABASE
# Ganti nama database, user, dan password sesuai cPanel hosting.
#--------------------------------------------------------------------
database.default.hostname = localhost
database.default.database = NAMA_DATABASE
database.default.username = USER_DATABASE
database.default.password = PASSWORD_DATABASE
database.default.DBDriver = MySQLi
database.default.port     = 3306

database.data.hostname = localhost
database.data.database = NAMA_DATABASE
database.data.username = USER_DATABASE
database.data.password = PASSWORD_DATABASE
database.data.DBDriver = MySQLi
database.data.port     = 3306

database.backend.hostname = localhost
database.backend.database = NAMA_DATABASE
database.backend.username = USER_DATABASE
database.backend.password = PASSWORD_DATABASE
database.backend.DBDriver = MySQLi
database.backend.port     = 3306

#--------------------------------------------------------------------
# INLISLite
# Token secret sebaiknya diganti dengan string acak panjang sebelum
# go-live. Mengganti nilai ini akan membuat semua sesi login lama
# tidak berlaku (pengguna cukup login ulang).
# encryption.key jangan diubah jika sudah ada data terenkripsi.
#--------------------------------------------------------------------
encryption.key = INLISLITE-PERPUSNAS-RI
security.TOKEN_SECRET = GANTI_DENGAN_STRING_ACAK_PANJANG
security.TOKEN_IAT = 10
security.TOKEN_NBF = 60
security.TOKEN_EXP = 3600
security.TOKEN_ALG = 'HS256'

GEMINI_API_KEY =
GEMINI_MODEL = gemini-3-flash-preview

#--------------------------------------------------------------------
# HCAPTCHA
# Opsi A (disarankan sementara): nonaktifkan sampai punya key baru
# untuk domain inlislite.solokkab.go.id.
# Opsi B: isi key resmi lalu hapus/isi HCAPTCHA_DISABLED=false.
#--------------------------------------------------------------------
HCAPTCHA_DISABLED = true
HCAPTCHA_SITE_KEY =
HCAPTCHA_SECRET_KEY =

# Isi API_KEY dengan key dari INLISLite/Perpusnas jika fitur
# sinkronisasi dashboard digunakan.
API_KEY = GANTI_API_KEY
FLASK_API_BASEURL = "https://api-inlislite.perpusnas.go.id/"

#--------------------------------------------------------------------
# EMAIL (sesuaikan bila fitur kirim email dipakai)
#--------------------------------------------------------------------
email.SMTPHost = smtp.gmail.com
email.SMTPUser =
email.SMTPPass =
email.SMTPPort = 587
email.SMTPCrypto = tls
email.fromEmail = noreply@solokkab.go.id
email.fromName = "Perpustakaan Umum Kabupaten Solok"

#--------------------------------------------------------------------
# CACHE / FITUR
#--------------------------------------------------------------------
is_opac_cache = 0
is_dashboard_cache = 0
is_home_cache = 0
Is_keanggotaan_online = 1
is_populer = 0
is_sering_dipinjam = 0
is_sering_dibaca = 0
